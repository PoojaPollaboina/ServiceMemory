# ServiceMemory environment variables.
# Copy to .env.local and fill in. NEVER commit .env.local.
# Every variable below is SERVER-SIDE ONLY (none use the NEXT_PUBLIC_ prefix).

# --- Hindsight Cloud (organizational memory) ---
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_replace_me
# One bank holds the whole organization's service experience.
HINDSIGHT_BANK_ID=servicememory-org

# --- Supabase (transactional source of truth) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# --- LLM provider (extraction + recommendations) ---
# OpenRouter — uses the OpenAI-compatible /chat/completions endpoint.
# Get a free key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # (optional override)
